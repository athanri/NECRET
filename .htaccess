# 1. FORCE HTTPS
RewriteEngine On
RewriteBase /
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,NE,L]

# 2. FORCE LOWERCASE COMPATIBILITY ROUTING
# Uses standard server logic loop instead of an external server map function
RewriteRule [A-Z] - [E=HASCAPS:TRUE,S=1]
RewriteRule ![A-Z] - [S=28]
# ... [Series of RewriteRules to convert A-Z to a-z] ...
RewriteCond %{ENV:HASCAPS} TRUE
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 3. CLEAN EXTENSIONS (Hide .php in URL)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 4. INTERNAL ROUTING (Maps cleaned URL back to file)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [NC,L]
